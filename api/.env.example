# deno-api configuration — standalone (non-compose) development only.
# Via docker-compose these come from the root .env automatically.
# Every value the backend reads lives in api/config.ts — nothing is hardcoded.

# HTTP port (compose sets 4001; deno-api runs network_mode: host)
PORT=4001

# Serve the built frontend from this dir (production single-container mode)
# STATIC_DIR=./dist

# ── Mothership / engine (voipappz-api) ──────────────────────────────────────
# Forward target for the same-origin /api, /auth, /tasks browser traffic, and
# the transcript read source. Server-side basic auth — NEVER VITE_-prefixed.
# ENGINE_URL=https://cloud.voipappz.io
# ACCOUNT_EMAIL=
# ACCOUNT_PASSWORD=

# ── PostgREST (optional /auth/login proxy) ──────────────────────────────────
# POSTGREST_URL=http://127.0.0.1:3001

# ── Cable (va-crystal ActionCable) — live call events → /ws/events ──────────
# Set SECRET_KEY (the cable's signing secret; deno mints the JWT itself) or a
# ready-made CABLE_TOKEN. Neither ⇒ the live relay stays off.
# SECRET_KEY=
# CABLE_URL=ws://127.0.0.1:6000/cable
# CABLE_CHANNEL=CallEvents
# CABLE_TOKEN=
# CABLE_ACCOUNT_UUID=events-consumer
# CABLE_DASHBOARD_UUID=          # set (with a real account uuid) to bridge DashboardLive

# ── InfluxDB 3 — dashboard calls-per-hour ───────────────────────────────────
# BOTH url and token required to enable; token is server-side only.
# INFLUXDB_URL=http://influx.example.com:8181
# INFLUXDB_TOKEN=
# INFLUXDB_DATABASE=telegraf

# /health marks the event stream stale after this many silent seconds (0 = off)
# EVENTS_STALE_SECONDS=900
