# Deno API Configuration
# When running via docker-compose, these are set automatically from root .env
# This file is only needed for standalone Deno development (without docker-compose)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application
PORT=3000

# DuckDB built-in browser UI — a live SQL notebook over the event store the AMQP
# tap writes to (in-process, sees incoming data live). Off by default. Turn on
# with `make duckdb-ui`, or set these and recreate deno-api.
# DUCKDB_UI=1
# DUCKDB_UI_PORT=4213
# HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt   # RHEL: /etc/pki/tls/certs/ca-bundle.crt

# SMTP (PDF email delivery)
SMTP_HOST=smtp.pepipost.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=alert@voipappz.com

# DocuSeal (e-signing)
DOCUSEAL_API_KEY=your-docuseal-api-key
DOCUSEAL_WEBHOOK_SECRET_KEY=X-Webhook-Secret
DOCUSEAL_WEBHOOK_SECRET=your-webhook-secret

# Fireberry CRM
FIREBERRY_TOKEN=your-fireberry-token

# Call transcription (Google Gemini) — server-side only, NEVER prefix with VITE_.
# When set, completed calls with a resolvable recording are auto-transcribed.
GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.0-flash          # default; any audio-capable Gemini model
# RECORDINGS_DIR=/recordings             # fallback: <dir>/<call_id>.{wav,mp3,ogg,opus,m4a,flac} when no URL/S3
# TRANSCRIBE_CONCURRENCY=2               # parallel transcriptions
# TRANSCRIBE_ENABLED=0                   # force-disable even if a key is present

# MinIO / S3 recordings (root stack: endpoint 127.0.0.1:9000, bucket "recordings").
# Set these (or reuse the stack's VA_S3_* / S3_*) so the worker pulls call audio from MinIO.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_KEY=${VA_S3_KEY}                    # MinIO access key (root user)
# S3_SECRET=${VA_S3_SECRET}             # MinIO secret key
# S3_REGION=us-east-1
# S3_RECORDINGS_BUCKET=recordings
# S3_RECORDINGS_PREFIX=                  # key prefix when probing <prefix><call_id>.<ext>
# S3_FORCE_PATH_STYLE=1                  # MinIO needs path-style (default on)
