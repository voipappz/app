{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "mcp": {
    "servers": {
      "supabase": {
        "command": "npx",
        "args": [
          "supabase-mcp"
        ],
        "env": {
          "SUPABASE_URL": "${VITE_SUPABASE_URL}",
          "SUPABASE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}",
          "SUPABASE_PROJECT_REF": "your-project-ref"
        }
      }
    }
  }
}