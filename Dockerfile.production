# Multistage build: React frontend + Deno backend in a single image.
# Stage 1 builds the React bundle. Stage 2 runs Deno, which both serves the
# built assets from /app/dist and dispatches API routes under /apps/*.

# Stage 1: Build React app
FROM node:24-alpine AS frontend-builder
WORKDIR /build

# NOTHING that changes per-build may sit above `npm ci`. A changed layer
# invalidates every layer below it, and the install is the expensive one (~525
# packages). VITE_APP_VERSION is a fresh date+sha on EVERY deploy, so while it
# lived up here the install could never be reused — a version-only rebuild cost
# 37s against 43s cold, i.e. the cache bought us nothing.
COPY package.json package-lock.json ./
# The download cache persists across builds; node_modules still lands in the
# layer, so the runtime image is unaffected. sharing=locked because CI can run
# two builds at once (a push and a PR), and concurrent writers to one package
# cache is how you corrupt it.
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci

COPY . .

# Per-build values go BELOW the install. Both are baked into the bundle, so a
# change here has to re-run `npm run build` — but only that.
ARG VITE_APP_VERSION
ENV VITE_APP_VERSION=$VITE_APP_VERSION

# VITE_MOTHERSHIP_URL is the DIRECT-mode escape hatch only. Leave it unset
# (the default): the bundle then uses RELATIVE URLs and all backend traffic
# rides this container's deno forwarder (ENGINE_URL picks the mothership at
# runtime). Set it only for static-only hosting builds (e.g. Fireberry embed).
ARG VITE_MOTHERSHIP_URL
ENV VITE_MOTHERSHIP_URL=$VITE_MOTHERSHIP_URL

RUN npm run build

# Stage 2: Deno runtime serving React + API
FROM denoland/deno:2.5.3
WORKDIR /app

COPY api/deno.json api/deno.lock ./
COPY api/*.ts ./
RUN deno cache app.ts

COPY --from=frontend-builder /build/dist ./dist

ENV STATIC_DIR=/app/dist
ENV PORT=3000
ENV EVENT_STORE_PATH=/data/events.duckdb
EXPOSE 3000

# Healthcheck handled by kamal-proxy (proxy.healthcheck.path: /test in
# config/deploy.yml). Avoiding a Dockerfile HEALTHCHECK because Deno 2.5's
# `deno eval` does not accept --allow-* flags.

RUN mkdir -p /data && chown deno:deno /data

USER deno

CMD ["deno", "run", "--allow-net", "--allow-env", "--allow-read", "--allow-write", "--allow-ffi", "app.ts"]
