# Multistage build: React frontend + Deno backend in a single image.
# Stage 1 builds the React bundle. Stage 2 runs Deno, which both serves the
# built assets from /app/dist and dispatches API routes under /apps/*.

# Stage 1: Build React app
FROM node:24-alpine AS frontend-builder
WORKDIR /build

ARG VITE_APP_VERSION
ENV VITE_APP_VERSION=$VITE_APP_VERSION

# VITE_MOTHERSHIP_URL is the DIRECT-mode escape hatch only. Leave it unset
# (the default): the bundle then uses RELATIVE URLs and all backend traffic
# rides this container's deno forwarder (ENGINE_URL picks the mothership at
# runtime). Set it only for static-only hosting builds (e.g. Fireberry embed).
ARG VITE_MOTHERSHIP_URL
ENV VITE_MOTHERSHIP_URL=$VITE_MOTHERSHIP_URL

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Deno runtime serving React + API
FROM denoland/deno:2.5.3
WORKDIR /app

COPY api/deno.json api/deno.lock ./
COPY api/*.ts ./
RUN deno cache app.ts

COPY --from=frontend-builder /build/dist ./dist

ENV STATIC_DIR=/app/dist
ENV PORT=3000
EXPOSE 3000

# Healthcheck handled by kamal-proxy (proxy.healthcheck.path: /test in
# config/deploy.yml). Avoiding a Dockerfile HEALTHCHECK because Deno 2.5's
# `deno eval` does not accept --allow-* flags.

USER deno

CMD ["deno", "run", "--allow-net", "--allow-env", "--allow-read", "app.ts"]
