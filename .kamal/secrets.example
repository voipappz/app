# Copy this file to .kamal/secrets and fill in real values.
# .kamal/secrets is gitignored — do not commit it.
#
# Only build-time / deploy-time values live here. Runtime app secrets
# (SUPABASE_SERVICE_ROLE_KEY, SMTP_PASS, DOCUSEAL_*, FIREBERRY_TOKEN, …)
# live on the production host at /etc/voipappz/secrets.env and are NEVER
# in this file, in the repo, or in CI.

# Docker Hub PAT used to push the built image.
KAMAL_REGISTRY_PASSWORD=

# VITE_* values get baked into the React bundle at build time. These are
# PUBLIC (anon keys ship to every browser), so it is safe to keep them here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
