# Deploy-time secrets for kamal. NOTHING IN THIS DIRECTORY EXCEPT THIS FILE IS
# TRACKED — .kamal/secrets*, *.key and *.pem are gitignored, and this repo is
# public.
#
# Only build-time / deploy-time values belong here. The admin is a static
# bundle: it has no runtime secrets at all. VITE_* values are baked into the
# public bundle at build time and are therefore NOT secrets — they live in the
# destination's deploy.<dest>.yml under builder.args.

# Docker Hub token used to push the built image.
KAMAL_REGISTRY_PASSWORD=

# WHICH FILE A DEPLOY READS — the trap that bit the portal:
#
#   kamal deploy              reads .kamal/secrets
#   kamal deploy -d <dest>    reads .kamal/secrets-common AND .kamal/secrets.<dest>
#                             ONLY, and fails with
#     Secret 'KAMAL_REGISTRY_PASSWORD' not found, no secret files
#     (.kamal/secrets-common, .kamal/secrets.<dest>) provided
#
# Every deploy from this repo is a destination deploy (the Makefile requires
# DEST), so the file to create is secrets-common:
#
#   cp .kamal/secrets.example .kamal/secrets-common   # then fill it in
#
# A destination that needs something of its own gets .kamal/secrets.<dest>.
