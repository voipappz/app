# Per-destination HOST details for kamal — copy to .kamal/env.<dest> and fill
# in. GITIGNORED, because this repo is public and a production host's address,
# SSH user and port are reconnaissance material even though none is a secret.
#
#   cp .kamal/env.example .kamal/env.connectix
#
# The Makefile passes this file to the kamal container with --env-file, and
# config/deploy.<dest>.yml reads the values through ERB. A missing KAMAL_HOST
# stops `kamal config` with a message naming this file, rather than deploying
# to the base file's unresolvable placeholder.

# The box kamal SSHes to. An IP or a resolvable name.
KAMAL_HOST=

# SSH into it. Defaults if left empty: root, 22, ~/.ssh/id_ed25519 — the key
# path is as seen INSIDE the kamal container, where ~/.ssh is your own,
# mounted read-only.
KAMAL_SSH_USER=
KAMAL_SSH_PORT=
KAMAL_SSH_KEY=
