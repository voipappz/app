{
  "name": "voipappz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:e2e": "concurrently \"npm run dev\" \"npx wait-on http://localhost:3000 && npm run test\"",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:run": "vitest run",
    "security-scan": "npx audit-ci --config audit-ci.jsonc --moderate",
    "test-quality": "npm run lint && npm run test:unit:run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
