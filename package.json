    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "form-data": "^4.0.6",
    "jwt-decode": "^4.0.0",
    "luaparse": "^0.3.1",
    "moment": "^2.31.0",
    "monaco-editor": "^0.53.0",
