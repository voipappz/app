{
  "name": "voipappz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:native": "concurrently -k -n vite,deno \"vite\" \"PORT=4001 deno run --watch=api/ -A api/app.ts\"",
    "serve": "STATIC_DIR=./dist PORT=4200 deno run --watch=api/ -A api/app.ts",
    "dev:unified": "vite build && concurrently -k -n vite,deno \"vite build --watch\" \"npm:serve\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:pw": "playwright test",
    "test:pw:headed": "playwright test --headed",
    "test:pw:debug": "playwright test --debug",
    "test:pw:report": "playwright show-report",
    "verify:push": "bash scripts/verify-before-push.sh",
    "prepare": "git config core.hooksPath .githooks || true",
    "security-scan": "npx audit-ci --moderate",
    "test-quality": "npm run lint"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.42",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fireberry/sdk": "^0.3.1",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.8.4",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.8.1",
    "sip.js": "^0.21.2",
    "stylis-plugin-rtl": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "dotenv": "^17.2.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.9.6"
  }
}
