# ============================================================================
# voipappz app — example environment
# ----------------------------------------------------------------------------
# Copy to .env and fill in your values:   cp .env.example .env
#
# Everything runs in Docker (docker compose up -d react-app deno-api) — nothing
# is installed on the host. This file is the single place external services are
# configured. Internal data (calls/reports/dashboard) lives in an EMBEDDED
# DuckDB file — no credentials, nothing to configure.
#
# Vars are read by:
#   - the React frontend  → only VITE_* vars (baked into the browser bundle)
#   - the Deno backend    → everything else (api/config.ts). NEVER prefix a
#                           secret/broker credential with VITE_ — it would leak
#                           into the public frontend bundle.
#
# Docker networking note: the containers are on a bridge network, so 127.0.0.1
# means "this container", NOT the host. To reach a broker / MinIO running on the
# HOST (e.g. the root voipappz-node stack), use host.docker.internal and add
#   extra_hosts: ["host.docker.internal:host-gateway"]   (Linux) to the service.
# ============================================================================

# ── Supabase (REQUIRED — auth + users table) ────────────────────────────────
# Frontend (VITE_ prefix required by Vite):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-default-key
# Backend service role (server-side only — NEVER VITE_):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Deno API server ─────────────────────────────────────────────────────────
PORT=4000
# DuckDB event-store file (embedded, server-side). Persisted to ./api/data via
# the ./api bind mount. No external dependency.
DUCKDB_PATH=/app/data/events.duckdb

# ── Frontend → PostgREST calls/events READ API (VITE_) ──────────────────────
# The Calls/Reports screens read from PostgREST (api.calls / api.events) — the
# Postgres event store, not deno/DuckDB. '' or '/rest/v1' = same-origin (Vite
# proxy in dev, Kong in prod). The browser never holds a host/port.
VITE_REST_URL=/rest/v1
# Dev proxy target for /rest/v1 → KONG (owns the /rest/v1 route, strips it to
# PostgREST). Kong is host-networked on :8000. PostgREST itself is loopback-only
# (127.0.0.1:3001) so never target it directly from a container.
# VITE_POSTGREST_TARGET=http://127.0.0.1:8000          # host-run vite
# VITE_POSTGREST_TARGET=http://host.docker.internal:8000   # react-app container
# How the admin gets its PostgREST token. Default: deno mints it from the
# Supabase session at /events_token (auth via the app login). Overrides:
# VITE_EVENTS_TOKEN=eyJ...              # a ready-made token (skip minting)
# VITE_EVENTS_TOKEN_URL=/events_token   # token-mint endpoint (deno)
# VITE_EVENTS_EMAIL= / VITE_EVENTS_PASSWORD=   # dev only: direct /rpc/login

# Shared secret the deno /events_token mint signs with — MUST equal PostgREST's
# VA_PGRST_JWT_SECRET (in /opt/va/va-installer/.env) or PostgREST rejects tokens.
# VA_PGRST_JWT_SECRET=

# ── Frontend → deno worker (transcription/recording) + live WS (VITE_) ──────
# The single deno-api still owns custom logic (transcribe/recording) + LiveEvents
# WS. '' = same-origin (Vite proxy / prod).
VITE_EVENTS_API_URL=
VITE_EVENTS_WS_URL=ws://localhost:4001/ws/events?topics=call.%23
# VITE_USE_MOCK=1                 # skip API/WS, render static mock calls

# ── Frontend brand identity (VITE_) — fully env-driven, rebrand per tenant ──
# Defaults to "voipappz" + the logos in public/brand/. No code change to rebrand.
# VITE_APP_NAME=voipappz                       # name: tab title, header, welcome
# VITE_BRAND_LOGO=/brand/voipappz-logo.png         # logo on light bg + favicon
# VITE_BRAND_LOGO_WHITE=/brand/voipappz-logo-white.png  # logo on dark login sidebar

# ── Frontend theming / build metadata (VITE_) ───────────────────────────────
# VITE_PRIMARY_COLOR=#00ADB4      # per-tenant brand/primary color (src/theme)
# VITE_APP_VERSION=dev            # shown in the footer; baked at build time

# ── Vite dev-server proxy targets (dev only) ────────────────────────────────
# The dev server listens on :4200 (vite.config server.port). These reroute
# proxied paths to upstreams. Defaults are baked into vite.config; override here
# when running the Deno API in Docker (service name) or elsewhere.
# VITE_API_TARGET=https://cloud.voipappz.io      # /api/*  upstream
# VITE_DENO_API_TARGET=http://deno-api:4000      # /deno-api,/apps → deno-api (NOTE: deno-api runs on 4000)
# VITE_EVENTS_TARGET=http://deno-api:4000        # /events-api,/ws/events → deno-api

# ── Playwright (E2E tests) ──────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=http://localhost:4200      # app URL the suite drives
# Accounts-table login used by the auth suite (deno /auth/login → PostgREST
# /rpc/login). Skipped if unset. Use a real account from the local `accounts` table.
ACCOUNT_EMAIL=
ACCOUNT_PASSWORD=

# ── Cable (va-crystal ActionCable server) — live call-event source ──────────
# deno-api subscribes to the cable server's CallEvents channel and projects
# events into DuckDB. Set SECRET_KEY (= the cable's SECRET_KEY) to enable it —
# deno mints the HS256 JWT itself. No SECRET_KEY ⇒ cable off (seed/mock only).
SECRET_KEY=                          # cable's signing secret (enables the live tap)
CABLE_URL=ws://127.0.0.1:6000/cable  # external cable server
# CABLE_TOKEN=eyJ...                 # alternative: a ready-made JWT
# MOCK_SEED=1                        # seed demo calls (tests/demo only)

# ── MinIO / S3 (EXTERNAL — call recordings for transcription) ────────────────
# Set endpoint + creds so the transcription worker can pull call audio. Accepts
# either S3_* or the root-stack's VA_S3_* names. Leave unset → recordings off.
# S3_ENDPOINT=http://host.docker.internal:9000
# S3_KEY=your-minio-access-key
# S3_SECRET=your-minio-secret-key
# S3_REGION=us-east-1              # ignored by MinIO, required by the SDK
# S3_RECORDINGS_BUCKET=recordings
# S3_RECORDINGS_PREFIX=            # probe <prefix><call_id>.<ext>
# S3_FORCE_PATH_STYLE=1            # MinIO needs path-style (default on)

# ── Google Gemini (EXTERNAL — call transcription) ────────────────────────────
# Worker stays OFF until a key is set (stack runs key-free). NEVER VITE_.
# GEMINI_API_KEY=your-google-ai-studio-key   # or GOOGLE_API_KEY
# GEMINI_MODEL=gemini-2.0-flash               # any audio-capable Gemini model
# RECORDINGS_DIR=/recordings                  # local fallback: <dir>/<call_id>.<ext>
# TRANSCRIBE_CONCURRENCY=2                     # parallel transcriptions
# TRANSCRIBE_ENABLED=0                         # force-disable even with a key

# ── SMTP (EXTERNAL — PDF/contract email via Pepipost) ────────────────────────
# SMTP_HOST=smtp.pepipost.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=alert@voipappz.com

# ── DocuSeal (EXTERNAL — e-signing) ──────────────────────────────────────────
# DOCUSEAL_API_KEY=your-docuseal-api-key
# DOCUSEAL_BASE_URL=https://api.docuseal.eu/api   # default
# DOCUSEAL_WEBHOOK_SECRET_KEY=X-Webhook-Secret    # header name for verification
# DOCUSEAL_WEBHOOK_SECRET=your-webhook-secret

# ── Fireberry (EXTERNAL — CRM sync) ──────────────────────────────────────────
# FIREBERRY_TOKEN=your-fireberry-token

# ── ngrok (dev only — tunnel deno-api for DocuSeal webhooks) ─────────────────
# NGROK_AUTHTOKEN=your-ngrok-token

# ============================================================================
# Test users — one Supabase auth account per app role, used by the RLS / RBAC
# Playwright suites (tests/helpers/test-users.ts → signInAs()). Only set the
# roles you created in Supabase; helpers skip tests for any missing role.
# ============================================================================
TEST_USER_ADMIN_EMAIL=
TEST_USER_ADMIN_PASSWORD=
TEST_USER_SUPER_ADMIN_EMAIL=
TEST_USER_SUPER_ADMIN_PASSWORD=
TEST_USER_SALES_MANAGER_EMAIL=
TEST_USER_SALES_MANAGER_PASSWORD=
TEST_USER_GENERAL_SALES_MANAGER_EMAIL=
TEST_USER_GENERAL_SALES_MANAGER_PASSWORD=
TEST_USER_SALES_AGENT_SMB_EMAIL=
TEST_USER_SALES_AGENT_SMB_PASSWORD=
TEST_USER_SALES_AGENT_SME_EMAIL=
TEST_USER_SALES_AGENT_SME_PASSWORD=
TEST_USER_SALES_AGENT_READONLY_EMAIL=
TEST_USER_SALES_AGENT_READONLY_PASSWORD=
TEST_USER_MARKETING_MANAGER_EMAIL=
TEST_USER_MARKETING_MANAGER_PASSWORD=
TEST_USER_BACK_OFFICE_MANAGER_EMAIL=
TEST_USER_BACK_OFFICE_MANAGER_PASSWORD=
TEST_USER_TECHNICIAN_EMAIL=
TEST_USER_TECHNICIAN_PASSWORD=
TEST_USER_TECHNICIAN_READONLY_EMAIL=
TEST_USER_TECHNICIAN_READONLY_PASSWORD=

# Playwright API specs that hit a deployed Deno API (skipped if unset):
# PLAYWRIGHT_API_BASE_URL=https://your-deploy.example.com
# PDF_TEST_ORDER_ID=
