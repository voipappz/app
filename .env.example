# ============================================================================
#  VoIPAppz portal — environment
#  Copy to `.env` and fill in:   cp .env.example .env   (or: make env)
#  A tenant fork changes ENV, not code.
#
#  Who reads what:
#   - React frontend → only VITE_* vars (baked into the browser bundle).
#   - deno backend   → the non-VITE_ vars (api/config.ts). NEVER prefix a
#                      secret with VITE_ — it would leak into the public bundle.
# ============================================================================

# ── The one knob: which mothership (voipappz-api) this tenant talks to ──────
# Read by the Vite dev proxy, the deno forwarder in prod, and `make dev`'s
# preflight — one name, three consumers, no duplication. Unprefixed on purpose:
# it must never reach the browser bundle. The browser always uses RELATIVE URLs
# and gets there same-origin through the proxy (dev) / forwarder (prod), so no
# backend host is ever baked in.
MOTHERSHIP_URL=https://cloud.voipappz.io

# Everything below is OPTIONAL — the app runs with just the line above.

# ── Mothership path overrides (defaults shown; set only if a tenant differs) ─
# VITE_MOTHERSHIP_LOGIN_PATH=/auth/user_login          # step 1: credentials
# VITE_MOTHERSHIP_OTP_PATH=/auth/user/otp/verify       # step 2: OTP code
# VITE_PORTAL_DATA_PATH=/tasks/customer_portal_data    # public branding

# ── Escape hatches (leave unset unless you know you need them) ──────────────
# VITE_MOTHERSHIP_URL — DIRECT mode: the browser calls the mothership
#   cross-origin, bypassing the app server. Only for static-only hosting with
#   no proxy in front (e.g. the Fireberry embed). Setting it can trip CORS.
# ENGINE_URL — override MOTHERSHIP_URL for the deno forwarder alone, when the
#   engine lives somewhere other than the mothership.
# VITE_API_TARGET — override MOTHERSHIP_URL for the Vite dev proxy alone.
# VITE_DENO_API_TARGET=http://localhost:4001   # when deno-api isn't on localhost
# Do NOT set VITE_API_BASE_URL in dev — it bypasses the Vite proxy and trips CORS.

# ── Softphone (WebRTC / SIP) ────────────────────────────────────────────────
# The softphone is configured from the LOGGED-IN USER OBJECT the mothership
# returns (extension.{username,password} + environment.{domain,wss_server}) —
# no endpoint is baked into the code. These are dev/demo overrides only; with
# neither env nor user data the softphone stays unconfigured.
# VITE_SIP_WSS_URL=wss://sbc.example.com:8443
# VITE_SIP_DOMAIN=tenant.example.com
# VITE_SIP_USERNAME=
# VITE_SIP_PASSWORD=
# VITE_SIP_AUTOCONNECT=false
# VITE_SIP_STUN=stun:stun.l.google.com:19302   # the default (vendor-neutral)
# VITE_SIP_TURN_URLS=
# VITE_SIP_TURN_USERNAME=
# VITE_SIP_TURN_CREDENTIAL=

# ── Dashboard extras (the deno backend) ─────────────────────────────────────
# The core app (login, calls, reports, features) needs NONE of these — it talks
# to the mothership directly. These only power three Dashboard widgets served by
# the local deno-api. Leave them unset and those widgets simply stay quiet.
#
# Live call-event stream (va-crystal ActionCable → /ws/events). Set SECRET_KEY
# (= the cable's signing secret) to enable it; deno mints the JWT itself.
# SECRET_KEY=
# va-crystal node's ActionCable endpoint (Cable transports over NATS).
# CABLE_URL=ws://127.0.0.1:4000/cable
# CABLE_CHANNEL=CallEvents
# CABLE_TOKEN=                                # alternative: a ready-made JWT
# CABLE_ACCOUNT_UUID=events-consumer
# CABLE_DASHBOARD_UUID=                       # + a real account uuid: bridge DashboardLive
# EVENT_STORE_PATH=/data/events.duckdb        # consumed events for local Dashboard only
# EVENT_RETENTION_DAYS=7                      # received-event retention (1..365)
#
# Transcript reads from the mothership event store (server-side basic auth):
# ACCOUNT_EMAIL=
# ACCOUNT_PASSWORD=
#
# EVENTS_STALE_SECONDS=900                    # /health marks the stream stale after this
# Optional analytics connector (not required by the DuckDB Dashboard):
# INFLUXDB_URL=http://influx.example.com:8181
# INFLUXDB_TOKEN=
# INFLUXDB_DATABASE=telegraf
#
# PostgREST — OPTIONAL second data plane for tenant-custom tables. Set to
# expose /rest/v1/* same-origin (deno strips the prefix and forwards; unset ⇒
# /rest/v1 answers 503 and the app is mothership-only):
# POSTGREST_URL=http://127.0.0.1:3001

# ── Cosmetics & dev toggles (all optional) ──────────────────────────────────
# VITE_APP_NAME=voipappz                      # tab title / header (else portal data)
# VITE_PRIMARY_COLOR=#00ADB4                  # brand colour (else portal data)
# VITE_APP_VERSION=dev                        # footer version label
# VITE_MOCK_LOGIN=1                           # offline login: any email → OTP below
# VITE_MOCK_OTP_CODE=123456                   # code the mock login accepts
# VITE_USE_MOCK=1                             # seed mock calls when the API is unreachable

# ── Deploy / ops ────────────────────────────────────────────────────────────
# PROD_URL=https://your-host                  # `make status` health probe target

# ── Tests (Playwright) ──────────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=http://localhost:4200   # app URL the suite drives (default local)
