# ---------------------------------------------------------------------------
# Copy to .env and fill in. `.env` is gitignored — never commit real values.
#     cp .env.example .env
# ---------------------------------------------------------------------------

# The voipappz-api instance this app talks to. The Vite dev server proxies
# /auth/* and /api/* here, so the browser only ever talks to localhost.
# `make onboard` (run by `make setup`) offers https://switch.voipappz.io while
# this is the placeholder below; point it at another instance or a local API.
VITE_API_BASE_URL=https://your-api-host.example.com

# --- Test credentials -------------------------------------------------------
# An account that exists in the VITE_API_BASE_URL database. Playwright signs in
# with these; without them the suite fails at the auth fixture.
TEST_EMAIL=you@example.com
TEST_PASSWORD=

# The API's OTP bypass code for test accounts. Login is a two-step OTP flow, so
# an automated run needs a code it can predict. This is a TEST-ONLY backdoor —
# it must never be set on a production API.
VA_TEST_OTP=

# --- Optional ---------------------------------------------------------------
# Gatus/health dashboard backing the Health Monitor screen. Unset = screen off.
VITE_MONITORING_BASE_URL=

# Zendesk widget key for the support/tickets integration. Unset = widget off.
VITE_ZENDESK_KEY=

